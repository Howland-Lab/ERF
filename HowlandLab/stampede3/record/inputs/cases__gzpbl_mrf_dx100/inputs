# grey-zone scan: convective case, dx = 100 m
# generated by make_week2_runs.py from cases/cbl_sd25
# gzpbl_mrf_dx100: grey-zone closure scan, MRF, dx = 100 m (make_gz_pbl_runs.py, 21 Oct 2026)
# ERF convective ABL (Shin & Dudhia 2016 set-up), mirror of the WRF run cbl_sd25.
# dx = dy = 25 m, dz = 20 m, 8 km x 8 km x 2 km, 4 h, Deardorff TKE.  See ERF_runs/README.md.
erf.prob_name = "ABL"
stop_time = 14400.0                       # 4 h (WRF run_hours = 4)
amrex.fpe_trap_invalid = 0   # MYNN trips the trap at step 1; profiles checked for NaN
geometry.prob_extent = 16000 16000 2000   # 16 km domain for the whole scan
amr.n_cell = 160 160 100   # dx = 100 m, dz = 20 m
geometry.is_periodic = 1 1 0
amr.max_level        = 0
amr.max_grid_size_x = 20
amr.max_grid_size_y = 20

# surface: MOST with prescribed heat flux (WRF: sf_sfclay_physics=1, isfflx=2, tke_heat_flux=0.20, z0=0.1)
zlo.type                = "surface_layer"
erf.most.z0             = 0.1
erf.most.surf_temp_flux = 0.20             # K m/s
zhi.type        = "SlipWall"
zhi.theta_grad  = 0.003                    # K/m, matches the sounding above the inversion

# initial state: the same input_sounding file WRF's ideal.exe read
erf.init_type           = "input_sounding"
erf.input_sounding_file = "input_sounding"
erf.sounding_type       = Ideal
prob.T_0_Pert_Mag       = 0.05             # WRF: theta += 0.1*(rand-0.5) on levels 1-4 (z < 80 m)
prob.pert_ref_height    = 80.0
prob.pert_rhotheta      = false
prob.KE_0               = 0.4

# time step (WRF: dt = 0.25 s, time_step_sound = 6)
erf.fixed_dt           = 1.00   # dt = dx/100 s, acoustic Courant ~0.6 with ratio 6 (same as WRF scan)
erf.fixed_mri_dt_ratio = 6
erf.substepping_type   = Implicit

# advection (WRF: 5th horizontal, 3rd vertical)
erf.dycore_horiz_adv_type  = "Upwind_5th"
erf.dycore_vert_adv_type   = "Upwind_3rd"
erf.dryscal_horiz_adv_type = "Upwind_5th"
erf.dryscal_vert_adv_type  = "Upwind_3rd"

# forcing (WRF ideal LES: f = 1.0e-4; pert_coriolis with base wind 10 m/s = geostrophic 10 m/s)
erf.use_gravity  = true
erf.use_coriolis = true
erf.coriolis_3d  = false
erf.latitude     = 90.0
erf.rotational_time_period = 125663.7061435917   # f = 4 pi / P = 1.0e-4
erf.abl_driver_type = "GeostrophicWind"
erf.abl_geo_wind    = 10.0 0.0 0.0

# closure (WRF: diff_opt=2, km_opt=2 Deardorff, c_k=0.10, C_eps = 0.19 + 0.74 l/Delta, K_h=(1+2l/Delta)K_m, TKE diff = 2 K_m)
erf.molec_diff_type = "None"
erf.les_type  = "Smagorinsky2D"   # horizontal 2-D Smagorinsky, like WRF km_opt=4
erf.Ck        = 0.10
erf.Ce        = 0.93
erf.Ce_wall   = 0.0
erf.sigma_k   = 0.5
erf.theta_ref = 300.0

# upper damping (WRF: damp_opt=2, zdamp=500, dampcoef=0.003 on u,v,w,theta)
erf.rayleigh_damp_U = true
erf.rayleigh_damp_V = true
erf.rayleigh_damp_W = true
erf.rayleigh_damp_T = true
erf.rayleigh_dampcoef = 0.003
erf.rayleigh_zdamp    = 500.

# output: plane averages every 60 s, 3-D plotfiles every 10 min
erf.v = 1
amr.v = 1
erf.sum_interval = 1000
erf.data_log     = surf_hist.dat mean_profiles.dat covar_profiles.dat sfs_profiles.dat
erf.profile_int  = 60   # every 60 s
erf.destag_profiles = false
erf.plot_file_1  = plt
erf.plot_per_1 = 300.0   # 13 plotfiles in the last hour
erf.plot_vars_1 = x_velocity y_velocity z_velocity theta rhoKE Kmv Khv
erf.check_file   = chk
erf.check_per    = 3600.0

erf.Cs = 0.25

erf.pbl_type = MRF   # vertical transport by the PBL scheme

prob.KE_decay_height = 1000.

prob.KE_decay_order = 3
