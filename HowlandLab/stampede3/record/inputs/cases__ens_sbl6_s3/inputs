# stable ensemble member, seed 3
# generated by make_week2_runs.py from cases/sbl_dx6p25
# ERF GABLS1 stable ABL, mirror of the WRF run sbl_dx6p25 (lab WRF-4.6.1 em_les namelist).
# dx = dy = dz = 6.25 m, 400 m cube, 9 h, Smagorinsky.  See ERF_runs/README.md.
erf.prob_name = "ABL"
stop_time = 32400.0                       # 9 h (WRF run_hours = 9)
amrex.fpe_trap_invalid = 1

geometry.prob_extent = 400 400 400
amr.n_cell           = 64 64 64
geometry.is_periodic = 1 1 0
amr.max_level        = 0
amr.max_grid_size_x  = 8                  # boxes of 8 x 8 columns (no split in z): 64 boxes
amr.max_grid_size_y  = 8

# surface: MOST, prescribed cooling (WRF: sf_sfclay_physics=1, isfflx=1, spec_sf_heatrate=-0.25, z0=0.1)
zlo.type                   = "surface_layer"
erf.most.z0                = 0.1
erf.most.surf_temp         = 265.0
erf.most.surf_heating_rate = -0.25         # K/h
zhi.type        = "SlipWall"
zhi.theta_grad  = 0.01                     # K/m, matches the sounding above 100 m

# initial state: the same input_sounding file WRF's ideal.exe read
erf.init_type           = "input_sounding"
erf.input_sounding_file = "input_sounding"
erf.sounding_type       = Ideal
prob.T_0_Pert_Mag       = 0.05             # WRF: theta += 0.1*(rand-0.5) on levels 1-4
prob.pert_ref_height    = 25.0
prob.pert_rhotheta      = false

# time step (WRF: dt = 0.0666666667 s, time_step_sound = 6)
erf.fixed_dt           = 0.0666666667
erf.fixed_mri_dt_ratio = 6
erf.substepping_type   = Implicit

# advection (WRF: h_mom/h_sca = 5, v_mom/v_sca = 3)
erf.dycore_horiz_adv_type  = "Upwind_5th"
erf.dycore_vert_adv_type   = "Upwind_3rd"
erf.dryscal_horiz_adv_type = "Upwind_5th"
erf.dryscal_vert_adv_type  = "Upwind_3rd"

# forcing (WRF: spec_lat = 73 -> f = 1.39e-4; pert_coriolis with base wind 8 m/s = geostrophic 8 m/s)
erf.use_gravity  = true
erf.use_coriolis = true
erf.coriolis_3d  = false
erf.latitude     = 73.0
erf.rotational_time_period = 86455.2516813368
erf.abl_driver_type = "GeostrophicWind"
erf.abl_geo_wind    = 8.0 0.0 0.0

# closure (WRF: diff_opt=2, km_opt=3, c_s=0.15, mix_isotropic=1, prandtl=1/3)
erf.molec_diff_type = "None"
erf.les_type = "Smagorinsky"
erf.Cs       = 0.15
erf.Pr_t     = 0.3333333
# stability: WRF K = (Cs D)^2 sqrt(max(0, S^2 - N^2/Pr)) = (Cs D)^2 S sqrt(1 - Ri/Pr); ERF multiplies by
# f = sqrt(1 - Ri/Ri_crit), Ri = N^2/S_vert^2 (default Ri_crit = 0.25) -> Ri_crit = 1/3 reproduces WRF
erf.use_Ri_correction = true
erf.Ri_crit  = 0.3333333

# upper damping (WRF: damp_opt=2, zdamp=100, dampcoef=0.003 on u,v,w,theta)
erf.rayleigh_damp_U = true
erf.rayleigh_damp_V = true
erf.rayleigh_damp_W = true
erf.rayleigh_damp_T = true
erf.rayleigh_dampcoef = 0.003
erf.rayleigh_zdamp    = 100.

# output: plane averages every 60 s, 3-D plotfiles every 10 min (WRF history_interval = 10 min)
erf.v = 1
amr.v = 1
erf.sum_interval = 1000
erf.data_log     = surf_hist.dat mean_profiles.dat covar_profiles.dat sfs_profiles.dat
erf.profile_int  = 900
erf.destag_profiles = false
erf.plot_file_1  = plt
erf.plot_per_1 = 120.0   # 3-D output every 2 min for ensemble statistics
erf.plot_vars_1 = x_velocity y_velocity z_velocity theta
erf.check_file   = chk
erf.check_per    = 7200.0
erf.random_seed = 3   # independent initial noise for this member
